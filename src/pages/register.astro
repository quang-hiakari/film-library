---
import BaseLayout from "../layouts/base-layout.astro";

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect("/");
}
---

<BaseLayout title="Register — Film Library">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="mx-auto max-w-sm py-16">
    <h2 class="mb-8 text-center font-serif text-3xl font-light text-film-text">Create account</h2>

    <div id="register-card" class="rounded-sm border border-film-border bg-film-surface p-8">
      <form id="register-form" class="space-y-5">
        <div>
          <label for="name" class="block text-xs tracking-widest uppercase text-film-muted mb-2">Name</label>
          <input id="name" name="name" type="text" required
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text placeholder-film-faint focus:border-film-amber/50 focus:outline-none transition-colors duration-200" />
        </div>
        <div>
          <label for="email" class="block text-xs tracking-widest uppercase text-film-muted mb-2">Email</label>
          <input id="email" name="email" type="email" required
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text placeholder-film-faint focus:border-film-amber/50 focus:outline-none transition-colors duration-200" />
        </div>
        <div>
          <label for="password" class="block text-xs tracking-widest uppercase text-film-muted mb-2">
            Password <span class="normal-case text-film-faint">(min 8)</span>
          </label>
          <input id="password" name="password" type="password" required minlength="8"
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text placeholder-film-faint focus:border-film-amber/50 focus:outline-none transition-colors duration-200" />
        </div>
        <div>
          <label for="confirm" class="block text-xs tracking-widest uppercase text-film-muted mb-2">Confirm password</label>
          <input id="confirm" name="confirm" type="password" required minlength="8"
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text placeholder-film-faint focus:border-film-amber/50 focus:outline-none transition-colors duration-200" />
        </div>
        <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-theme="dark"></div>
        <p id="error" class="hidden text-xs text-red-400"></p>
        <button type="submit"
          class="w-full cursor-pointer rounded-sm border border-film-amber/60 py-2.5 text-sm text-film-amber hover:bg-film-amber hover:text-film-bg transition-all duration-200 tracking-wide">
          Register
        </button>
      </form>
    </div>

    <div id="register-success" class="hidden rounded-sm border border-film-border bg-film-surface p-8 text-center">
      <h3 class="mb-3 font-serif text-2xl font-light text-film-text">Check your email</h3>
      <p class="text-sm text-film-muted">
        We sent a verification link to <span id="register-email" class="text-film-amber"></span>.
        Click it to activate your account.
      </p>
      <p class="mt-4 text-xs text-film-faint">Link expires in 24 hours.</p>
    </div>

    <p class="mt-6 text-center text-xs text-film-muted tracking-wide">
      Already have an account?
      <a href="/login" class="text-film-amber hover:text-film-amber-hover transition-colors duration-200 ml-1">Log in</a>
    </p>
  </div>

  <script>
    import { authClient } from "../lib/auth-client";

    const form = document.getElementById("register-form") as HTMLFormElement;
    const errorEl = document.getElementById("error") as HTMLParagraphElement;

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
      // @ts-ignore
      if (window.turnstile) window.turnstile.reset();
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");

      const data = new FormData(form);
      const password = data.get("password") as string;
      const confirm = data.get("confirm") as string;
      if (password !== confirm) { showError("Passwords do not match"); return; }

      const captchaToken = (data.get("cf-turnstile-response") as string | null)?.trim();
      if (!captchaToken) { showError("Please complete the CAPTCHA"); return; }

      const cap = await fetch("/api/verify-captcha", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token: captchaToken }),
      });
      if (!cap.ok) {
        const j = await cap.json().catch(() => ({})) as Record<string, string>;
        showError(j?.error === "captcha_failed" ? "CAPTCHA failed — try again." : "Could not verify CAPTCHA");
        return;
      }

      const { error } = await authClient.signUp.email({
        name: data.get("name") as string,
        email: data.get("email") as string,
        password,
      });
      if (error) { showError(error.message ?? "Registration failed"); return; }

      document.getElementById("register-card")!.classList.add("hidden");
      document.getElementById("register-email")!.textContent = data.get("email") as string;
      document.getElementById("register-success")!.classList.remove("hidden");
    });
  </script>
</BaseLayout>
