---
import BaseLayout from "../../../layouts/base-layout.astro";
import AdminCoverPicker from "../../../components/admin-cover-picker.astro";
import { getDb } from "../../../lib/db";
import { groups, rollAccess, rollGroupAccess, rolls, user as userTable } from "../../../lib/db-schema";
import { createSignedUrl } from "../../../lib/signed-url-service";
import { eq } from "drizzle-orm";

export const prerender = false;

const currentUser = Astro.locals.user;
if (!currentUser || currentUser.role !== "admin") return Astro.redirect("/");

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin");

const env = Astro.locals.runtime.env;
const db = getDb(env.DB);

const [rollRow, grants, allGroups, groupGrants] = await Promise.all([
  db.select().from(rolls).where(eq(rolls.slug, slug)).limit(1),
  db.select({ userId: rollAccess.userId, name: userTable.name, email: userTable.email })
    .from(rollAccess).innerJoin(userTable, eq(rollAccess.userId, userTable.id))
    .where(eq(rollAccess.rollSlug, slug)),
  db.select({ id: groups.id, name: groups.name }).from(groups).orderBy(groups.name),
  db.select({ id: groups.id, name: groups.name })
    .from(rollGroupAccess).innerJoin(groups, eq(groups.id, rollGroupAccess.groupId))
    .where(eq(rollGroupAccess.rollSlug, slug)),
]);

const row = rollRow[0];
const visibility = row?.visibility ?? "registered";

const fallbackTitle = slug
  .replace(/-\d{4}-\d{2}(?:-\d{2})?$/, "")
  .replace(/-/g, " ")
  .replace(/\b\w/g, (c) => c.toUpperCase()) || slug;

const [photoList, thumbList] = await Promise.all([
  env.R2.list({ prefix: `rolls/${slug}/` }),
  env.R2.list({ prefix: `rolls/${slug}/thumbs/` }),
]);
const thumbSet = new Set(
  thumbList.objects.map((o) => o.key.split("/").pop() ?? "").filter(Boolean)
);
const photoKeys = photoList.objects
  .map((o) => o.key)
  .filter((k) => k.split("/").length === 3 && /\.(jpe?g|png|webp)$/i.test(k))
  .sort();
const photos = await Promise.all(
  photoKeys.map(async (key) => {
    const filename = key.split("/").pop()!;
    const displayKey = thumbSet.has(filename) ? `rolls/${slug}/thumbs/${filename}` : key;
    return { key, url: await createSignedUrl(env, displayKey) };
  })
);

const grantedGroupIds = new Set(groupGrants.map((g) => g.id));
const availableGroups = allGroups.filter((g) => !grantedGroupIds.has(g.id));
---

<BaseLayout title={`Admin: ${slug} — Film Library`}>
  <div class="mb-8">
    <a href="/admin" class="text-xs tracking-widest uppercase text-film-muted hover:text-film-amber transition-colors duration-200">
      &larr; Back to admin
    </a>
  </div>

  <header class="mb-10 border-b border-film-border pb-8">
    <h2 class="font-serif text-3xl font-light text-film-text">{slug}</h2>
    <p class="mt-2 text-xs tracking-widest uppercase text-film-muted">
      Visibility: <span class="text-film-amber">{visibility}</span>
    </p>
  </header>

  <!-- Roll Info -->
  <section class="mb-10">
    <h3 class="mb-4 text-xs tracking-widest uppercase text-film-muted">Roll Info</h3>
    <form id="info-form" class="space-y-4">
      <div>
        <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Title</label>
        <input name="title" type="text" value={row?.title ?? ""} placeholder={fallbackTitle}
          class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors" />
        <p class="mt-1 text-xs text-film-faint">Leave empty to use default: "{fallbackTitle}"</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
        <div>
          <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Month / Year</label>
          <input name="date" type="month" value={row?.date ?? ""}
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors" />
        </div>
        <div>
          <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Film Stock</label>
          <input name="filmStock" type="text" value={row?.filmStock ?? ""}
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors" />
        </div>
        <div>
          <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Camera</label>
          <input name="camera" type="text" value={row?.camera ?? ""}
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors" />
        </div>
        <div>
          <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Frames</label>
          <input name="frames" type="number" min="0" value={row?.frames ?? ""}
            class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors" />
        </div>
      </div>
      <div>
        <label class="mb-1 block text-xs tracking-widest uppercase text-film-muted">Description</label>
        <textarea name="description" rows="3"
          class="w-full rounded-sm border border-film-border bg-film-bg px-3 py-2 text-sm text-film-text focus:border-film-amber/50 focus:outline-none transition-colors"
        >{row?.description ?? ""}</textarea>
      </div>
      <div class="flex items-center gap-3">
        <button type="submit" class="cursor-pointer rounded-sm border border-film-amber/60 px-4 py-2 text-xs tracking-widest uppercase text-film-amber hover:bg-film-amber hover:text-film-bg transition-all duration-200">Save</button>
        <span id="info-msg" class="hidden text-xs"></span>
      </div>
    </form>
  </section>

  <!-- Home Feature -->
  <section class="mb-10">
    <h3 class="mb-4 text-xs tracking-widest uppercase text-film-muted">Home Page</h3>
    <div class="flex items-center gap-4">
      <label class="flex items-center gap-3 cursor-pointer select-none">
        <input id="show-on-home" type="checkbox" checked={row?.showOnHome ?? false}
          class="h-4 w-4 cursor-pointer accent-amber-400" />
        <span class="text-sm text-film-text">Feature this roll on the home page</span>
      </label>
      <span id="home-msg" class="hidden text-xs"></span>
    </div>
    <p class="mt-1 text-xs text-film-faint">Only one roll can be featured at a time. Enabling this will unset any other featured roll.</p>
  </section>

  <!-- Cover Photo -->
  <section class="mb-12">
    <h3 class="mb-2 text-xs tracking-widest uppercase text-film-muted">Cover Photo</h3>
    <p class="mb-3 text-xs text-film-faint">Click a photo to set as cover.</p>
    <AdminCoverPicker photos={photos} currentCover={row?.coverPhotoKey ?? null} />
    <p id="cover-msg" class="mt-2 hidden text-xs"></p>
  </section>

  <!-- User Access -->
  <section class="mb-12">
    <h3 class="mb-5 text-xs tracking-widest uppercase text-film-muted">User Access</h3>
    {grants.length > 0 ? (
      <ul class="mb-6 space-y-2">
        {grants.map((g) => (
          <li class="flex items-center justify-between rounded-sm border border-film-border bg-film-surface px-4 py-3 text-sm">
            <span class="text-film-text">{g.name}<span class="ml-2 text-xs text-film-muted">{g.email}</span></span>
            <button class="remove-btn cursor-pointer text-xs tracking-widest uppercase text-film-muted hover:text-red-400 transition-colors duration-150" data-email={g.email}>Remove</button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mb-6 font-serif text-lg italic text-film-faint">No users invited yet.</p>
    )}
    <form id="invite-form" class="flex gap-3">
      <input id="invite-email" type="email" required placeholder="user@example.com"
        class="flex-1 rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text placeholder-film-faint focus:border-film-amber/50 focus:outline-none transition-colors duration-200" />
      <button type="submit" class="cursor-pointer rounded-sm border border-film-amber/60 px-5 py-2.5 text-xs tracking-widest uppercase text-film-amber hover:bg-film-amber hover:text-film-bg transition-all duration-200">Invite</button>
    </form>
    <p id="invite-msg" class="mt-2 hidden text-xs"></p>
  </section>

  <!-- Group Access -->
  <section>
    <h3 class="mb-5 text-xs tracking-widest uppercase text-film-muted">Group Access</h3>
    {groupGrants.length > 0 ? (
      <ul class="mb-6 space-y-2">
        {groupGrants.map((g) => (
          <li class="flex items-center justify-between rounded-sm border border-film-border bg-film-surface px-4 py-3 text-sm">
            <span class="text-film-text">{g.name}</span>
            <button class="remove-group-btn cursor-pointer text-xs tracking-widest uppercase text-film-muted hover:text-red-400 transition-colors duration-150" data-group-id={g.id}>Remove</button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mb-6 font-serif text-lg italic text-film-faint">No groups invited yet.</p>
    )}
    {availableGroups.length > 0 && (
      <form id="invite-group-form" class="flex gap-3">
        <select id="invite-group-select" class="flex-1 max-w-xs cursor-pointer rounded-sm border border-film-border bg-film-bg px-3 py-2.5 text-sm text-film-text focus:border-film-amber/50 focus:outline-none">
          {availableGroups.map((g) => <option value={g.id}>{g.name}</option>)}
        </select>
        <button type="submit" class="cursor-pointer rounded-sm border border-film-amber/60 px-5 py-2.5 text-xs tracking-widest uppercase text-film-amber hover:bg-film-amber hover:text-film-bg transition-all duration-200">Invite Group</button>
      </form>
    )}
    {allGroups.length === 0 && (
      <p class="text-xs text-film-faint">No groups exist yet. <a href="/admin/groups" class="text-film-amber hover:underline">Create one</a>.</p>
    )}
  </section>

  <script define:vars={{ slug }}>
    function showMsg(el, text, ok) {
      if (!el) return;
      el.textContent = text;
      el.className = `text-xs ${ok ? "text-film-amber" : "text-red-400"}`;
      el.classList.remove("hidden");
      setTimeout(() => el.classList.add("hidden"), 2500);
    }
    async function post(url, body) {
      return fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    }

    document.getElementById("show-on-home")?.addEventListener("change", async (e) => {
      const checked = e.currentTarget.checked;
      const res = await post("/api/admin/update-roll", { slug, showOnHome: checked });
      showMsg(document.getElementById("home-msg"), res.ok ? (checked ? "Now featured" : "Removed from home") : "Error", res.ok);
    });

    document.getElementById("info-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.currentTarget);
      const framesVal = fd.get("frames");
      const res = await post("/api/admin/update-roll", {
        slug,
        title: fd.get("title") || null,
        filmStock: fd.get("filmStock") || null,
        camera: fd.get("camera") || null,
        frames: framesVal ? Number(framesVal) : null,
        description: fd.get("description") || null,
        date: fd.get("date") || null,
      });
      showMsg(document.getElementById("info-msg"), res.ok ? "Saved" : "Error", res.ok);
    });

    document.querySelectorAll(".cover-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const res = await post("/api/admin/update-roll", { slug, coverPhotoKey: btn.dataset.coverKey });
        if (res.ok) {
          document.querySelectorAll(".cover-btn").forEach((b) => { b.classList.remove("border-film-amber"); b.classList.add("border-transparent"); });
          btn.classList.remove("border-transparent"); btn.classList.add("border-film-amber");
          showMsg(document.getElementById("cover-msg"), "Cover updated", true);
        } else showMsg(document.getElementById("cover-msg"), "Error", false);
      });
    });

    const inviteMsg = document.getElementById("invite-msg");
    document.getElementById("invite-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = document.getElementById("invite-email").value;
      const res = await post("/api/admin/roll-access", { rollSlug: slug, userEmail: email, action: "add" });
      if (res.ok) { showMsg(inviteMsg, `Invited ${email}`, true); setTimeout(() => location.reload(), 800); }
      else { const d = await res.json().catch(() => ({})); showMsg(inviteMsg, d.error || "Failed", false); }
    });
    document.querySelectorAll(".remove-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const res = await post("/api/admin/roll-access", { rollSlug: slug, userEmail: btn.dataset.email, action: "remove" });
        if (res.ok) { showMsg(inviteMsg, "Removed", true); setTimeout(() => location.reload(), 800); }
        else showMsg(inviteMsg, "Failed", false);
      });
    });
    document.getElementById("invite-group-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const res = await post("/api/admin/roll-group-access", { rollSlug: slug, groupId: document.getElementById("invite-group-select").value, action: "add" });
      if (res.ok) location.reload(); else showMsg(inviteMsg, "Failed to add group", false);
    });
    document.querySelectorAll(".remove-group-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const res = await post("/api/admin/roll-group-access", { rollSlug: slug, groupId: btn.dataset.groupId, action: "remove" });
        if (res.ok) location.reload(); else showMsg(inviteMsg, "Failed to remove group", false);
      });
    });
  </script>
</BaseLayout>
