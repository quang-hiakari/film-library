---
interface Props {
  photos: string[];
  title?: string;
  stock?: string;
}

const { photos, title, stock } = Astro.props;
---

<div
  id="lightbox"
  class="lb fixed inset-0 z-[90] hidden items-center justify-center"
  style="background: color-mix(in oklab, var(--bg) 96%, black); backdrop-filter: blur(8px);"
>
  <div class="absolute top-6 right-6 flex items-center gap-4">
    <button
      id="lb-rotate"
      class="bg-transparent border-0 text-film-muted hover:text-film-amber cursor-pointer transition-colors duration-200"
      aria-label="Rotate"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 2v6h-6" />
        <path d="M21 13a9 9 0 1 1-3-7.7L21 8" />
      </svg>
    </button>
    <button
      id="lb-close"
      class="bg-transparent border-0 text-film-muted hover:text-film-amber cursor-pointer transition-colors duration-200"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <button
    id="lb-prev"
    class="absolute left-6 top-1/2 -translate-y-1/2 bg-transparent border-0 text-film-muted hover:text-film-amber cursor-pointer transition-colors duration-200"
    aria-label="Previous"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 18 9 12l6-6" />
    </svg>
  </button>

  <button
    id="lb-next"
    class="absolute right-6 top-1/2 -translate-y-1/2 bg-transparent border-0 text-film-muted hover:text-film-amber cursor-pointer transition-colors duration-200"
    aria-label="Next"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 6 6 6-6 6" />
    </svg>
  </button>

  <img id="lb-img" class="max-w-[88vw] max-h-[84vh] object-contain shadow-[0_30px_80px_rgba(0,0,0,0.6)]" alt="" />

  <div class="absolute left-1/2 -translate-x-1/2 bottom-7 flex items-center gap-4.5 font-mono text-[11px] tracking-[0.14em] text-film-muted">
    <span id="lb-counter"></span>
    {stock && (<><span class="w-1 h-1 bg-film-faint rounded-full" /><span>{stock}</span></>)}
    {title && (<><span class="w-1 h-1 bg-film-faint rounded-full" /><span>{title}</span></>)}
  </div>
</div>

<script define:vars={{ photos }}>
  const lb = document.getElementById("lightbox");
  const img = document.getElementById("lb-img");
  const counter = document.getElementById("lb-counter");
  let current = 0;
  let startX = 0;
  let rotation = 0;

  function applyRotation() {
    img.style.transform = rotation ? `rotate(${rotation}deg)` : "";
    // swap max constraints when rotated 90/270 so portrait fills the viewport properly
    const sideways = rotation % 180 !== 0;
    img.style.maxWidth = sideways ? "84vh" : "";
    img.style.maxHeight = sideways ? "88vw" : "";
  }

  function show(i) {
    current = ((i % photos.length) + photos.length) % photos.length;
    img.src = photos[current];
    counter.textContent = `${String(current + 1).padStart(2, "0")} / ${String(photos.length).padStart(2, "0")}`;
    rotation = 0;
    applyRotation();
    lb.classList.remove("hidden");
    lb.classList.add("flex");
  }

  function hide() {
    lb.classList.add("hidden");
    lb.classList.remove("flex");
    rotation = 0;
  }

  document.querySelectorAll(".photo-thumb").forEach((btn) => {
    btn.addEventListener("click", () => show(Number(btn.dataset.index)));
  });

  document.getElementById("lb-close").addEventListener("click", hide);
  document.getElementById("lb-prev").addEventListener("click", () => show(current - 1));
  document.getElementById("lb-next").addEventListener("click", () => show(current + 1));
  document.getElementById("lb-rotate").addEventListener("click", () => {
    rotation = (rotation + 90) % 360;
    applyRotation();
  });

  lb.addEventListener("click", (e) => { if (e.target === lb) hide(); });

  document.addEventListener("keydown", (e) => {
    if (lb.classList.contains("hidden")) return;
    if (e.key === "Escape") hide();
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
    if (e.key === "r" || e.key === "R") { rotation = (rotation + 90) % 360; applyRotation(); }
  });

  lb.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; });
  lb.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
