---
interface Props {
  photos: string[];
  totalFrames?: number;
}

const { photos, totalFrames } = Astro.props;
const total = totalFrames ?? photos.length;
---

<div class="contact -mx-8 sm:-mx-8 -mx-5 my-12 py-7 bg-film-surface border-y border-film-hairline">
  <div class="contact-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-[18px] px-8 sm:px-8 px-5">
    {photos.map((url, i) => (
      <button
        class="photo-thumb frame-cell relative aspect-[3/2] overflow-hidden bg-film-bg cursor-zoom-in border-0 p-0"
        data-index={i}
      >
        <img
          src={url}
          alt={`Frame ${i + 1}`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-[transform,filter] duration-700 hover:scale-[1.025] hover:brightness-110"
        />
        <span class="absolute bottom-1.5 right-2 font-mono text-[10px] tracking-[0.08em] text-white/55" style="text-shadow: 0 1px 2px rgba(0,0,0,0.4);">
          {String(i + 1).padStart(2, "0")}/{String(total).padStart(2, "0")}
        </span>
      </button>
    ))}
  </div>
</div>

<style>
  /* Sprocket-hole motif: punched circles along top + bottom edges */
  .contact {
    background-image:
      radial-gradient(circle at 16px 18px, var(--bg) 4px, transparent 4.5px),
      radial-gradient(circle at 16px 18px, var(--bg) 4px, transparent 4.5px);
    background-position: 0 0, 0 100%;
    background-repeat: repeat-x;
    background-size: 32px 36px, 32px 36px;
  }
</style>
