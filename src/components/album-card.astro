---
import type { Visibility } from "../lib/access-control";

interface Props {
  slug: string;
  title: string;
  date: string;
  filmStock?: string;
  camera?: string;
  coverUrl: string;
  num?: string;
  visibility: Visibility;
  gated?: boolean;
}

const { slug, title, date, filmStock, camera, coverUrl, num, visibility, gated = false } = Astro.props;

const displayDate = new Date(date).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});

const badge =
  visibility === "private"
    ? { text: "Private" }
    : gated   // only show "Members" badge when user is NOT logged in
    ? { text: "Members" }
    : null;
---

<a href={`/rolls/${slug}`} class="card group block no-underline text-inherit cursor-pointer relative">
  <div
    class="frame relative overflow-hidden bg-film-surface border border-film-hairline transition-colors duration-500 group-hover:border-film-amber/40"
    style="aspect-ratio: 3/2;"
  >
    <img
      src={coverUrl}
      alt={title}
      loading="lazy"
      decoding="async"
      class="img-a absolute inset-0 h-full w-full object-cover transition-opacity duration-700"
    />
    {num && (
      <span class="absolute top-3 left-3 font-mono text-[10.5px] tracking-[0.1em] text-film-text/70">
        {num}
      </span>
    )}
    {badge && (
      <span class="absolute top-3 right-3 text-[9px] tracking-[0.22em] uppercase px-2 py-1 border border-film-hairline bg-film-bg/50 backdrop-blur-md text-film-text">
        {badge.text}
      </span>
    )}
  </div>
  <div class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1.5 pt-3.5 items-baseline">
    <h2 class="font-serif font-light text-[22px] leading-[1.15] text-film-text col-start-1 m-0 group-hover:text-film-amber transition-colors duration-300">
      {title}
    </h2>
    <span class="font-mono text-[10.5px] tracking-[0.1em] text-film-muted col-start-2 text-right whitespace-nowrap">
      {displayDate}
    </span>
    {(filmStock || camera) && (
      <span class="col-span-2 text-[11px] tracking-[0.16em] uppercase text-film-muted">
        {filmStock}
        {filmStock && camera && <span class="text-film-faint mx-2">·</span>}
        {camera}
      </span>
    )}
  </div>
</a>
